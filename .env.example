# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="MY_APP_URL"

# SUPABASE DATABASE PERSISTENCE (Render Environment Variables)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# FACILITY SECURITY CREDENTIALS
# Configure these in Render Environment Variables (Do NOT hardcode in code)
VIEWER_ACCESS_CODE="YOUR_VIEWER_CODE"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# FACILITY SETTINGS (Optional)
BUILDING_TIMEZONE="Asia/Baku"
BUILDING_NAME="IELTS Gate"
REQUIRE_VIEWER_CODE="true"

